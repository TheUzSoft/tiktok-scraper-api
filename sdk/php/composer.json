{
  "name": "theuzsoft/tiktok-scraper-api-sdk",
  "description": "PHP and Laravel SDK package for TikTok Scraper API",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*"
  },
  "autoload": {
    "psr-4": {
      "TheUzSoft\\\\TiktokScraper\\\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "TheUzSoft\\\\TiktokScraper\\\\TiktokScraperServiceProvider"
      ],
      "aliases": {
        "TiktokScraper": "TheUzSoft\\\\TiktokScraper\\\\Facades\\\\TiktokScraper"
      }
    }
  }
}